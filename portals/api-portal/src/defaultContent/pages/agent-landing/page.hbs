{{#pageHead}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
  <link rel="stylesheet" href="{{basePath}}/technical-styles/agent-prompt.css">
{{/pageHead}}
{{#pageScripts}}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" integrity="sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp" crossorigin="anonymous"></script>
  <script src='{{basePath}}/technical-scripts/agent-landing.js' defer></script>
  {{#if tryWithAi}}
  <script src='{{basePath}}/technical-scripts/api-agent-prompt.js' defer></script>
  <script type="application/json" id="apiAgentData">{"baseUrl":"{{baseUrl}}","id":"{{apiMetadata.id}}","resourcePath":"agent"}</script>
  {{/if}}
  {{#if subscriptionPlans.length}}
  <script src='{{basePath}}/technical-scripts/subscription.js' defer></script>
  <script src='{{basePath}}/technical-scripts/subscription-modal.js' defer></script>
  {{/if}}
{{/pageScripts}}
<div style="padding: 1rem 1.5rem 0;">
  <nav class="dp-breadcrumb">
    <a class="dp-breadcrumb-item" href="{{baseUrl}}/agents">Agents</a>
    <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
    <span class="dp-breadcrumb-current">{{apiMetadata.name}}</span>
  </nav>
</div>
<div class="container-fluid">
  {{> agent-detail-banner }}
</div>
<div class="aov-body">
  <div class="aov-body-main">
    {{!-- As for APIs and MCP servers: an uploaded landing page replaces the generated
          overview (the admin's choice); the Documentation button still reaches the
          definitions and documents. --}}
    {{#if landingHtml}}
    <section class="api-md-content">{{{landingHtml}}}</section>
    {{else}}
    {{!-- How to use first, then skills (Shamly, 2026-11-09), then authentication and the
          example request (2026-11-12). --}}
    {{#if agentView.tabs.length}}{{> agent-use }}{{/if}}
    {{> agent-what-it-does }}
    {{#if agentView.accessTabs.length}}{{> agent-access }}{{/if}}
    {{/if}}
  </div>
  {{!-- A sidebar only when it has something, as on API pages. About goes above the plans, as
        MCP puts its connection card above them, so a long plan list can't push it out of sight. --}}
  {{#if (or subscriptionPlans.length showDetails)}}
  <div class="aov-body-sidebar">
    {{> agent-details }}
    {{#if subscriptionPlans.length}}
    {{> mcp-subscription-plans kindLabel="agent" kindTitle="Agent" }}
    {{/if}}
  </div>
  {{/if}}
</div>
{{> alert }}
{{#if tryWithAi}}
<div id="agentPromptData" hidden data-name="{{apiMetadata.name}}" data-kinds="{{#each agentView.badges}}{{label}}{{#unless @last}}, {{/unless}}{{/each}}"></div>
{{> api-agent-prompt-modal promptSubject="agent"}}
{{/if}}
