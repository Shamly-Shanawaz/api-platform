{{!-- One endpoint, as the API page shows them: a labelled card, the URL, and the portal's Copy button. --}}
<div class="aov-endpoint-card">
  <div class="aov-endpoint-label-row">
    <span class="aov-endpoint-dot aov-endpoint-dot--{{dot}}"></span>
    <span class="aov-endpoint-label">{{label}}</span>
    {{#if detail}}<span class="dp-badge dp-badge--protocol agent-endpoint-detail">{{detail}}</span>{{/if}}
  </div>
  <div class="aov-endpoint-url-row">
    <i class="bi bi-link-45deg agent-endpoint-icon" aria-hidden="true"></i>
    <pre id="{{idPrefix}}-{{idSuffix}}" class="aov-endpoint-url agent-endpoint-url">{{url}}</pre>
    <button type="button" class="copy-btn" data-copy-target="{{idPrefix}}-{{idSuffix}}" title="Copy URL" aria-label="Copy {{label}} URL">
      <span class="copy-btn-icon"><i class="bi bi-copy"></i></span>
      <span class="copy-btn-check"><i class="bi bi-check"></i> Copied</span>
    </button>
  </div>
</div>
