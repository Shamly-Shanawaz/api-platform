{{#if agentView.skills.items.length}}
<section class="aov-section" id="agent-skills">
  <div class="aov-section-header">
    <h2 class="aov-section-title">Skills</h2>
    <span class="aov-section-count">{{agentView.skills.items.length}} {{conditionalIf (eq agentView.skills.items.length 1) "skill" "skills"}}</span>
  </div>
  <p class="agent-source-line">{{> agent-source source=agentView.skills.source }}</p>
  {{!-- MCP's tool fold-out (mc-accordion), open by default as on MCP pages; only the header
        colour differs (agent-skill-accordion: the portal's primary surface, not MCP's beige). --}}
  {{#each agentView.skills.items}}
  <div class="mc-accordion agent-skill-accordion">
    <div class="mc-accordion-head open" role="button" tabindex="0" aria-expanded="true" data-agent-accordion>
      <span class="mc-accordion-head-label"><i class="bi bi-lightning-charge" aria-hidden="true"></i> {{name}}</span>
      <i class="bi bi-chevron-up mc-accordion-chevron" aria-hidden="true"></i>
    </div>
    <div class="mc-accordion-body">
      {{#if description}}<p class="mc-accordion-desc">{{description}}</p>{{/if}}
      {{#if tags.length}}<div class="dp-tags">{{#each tags}}<span class="dp-tag">{{this}}</span>{{/each}}</div>{{/if}}
      {{#if examples.length}}
      <div class="mc-accordion-meta"><span class="mc-accordion-meta-key">Examples</span></div>
      <ul class="agent-examples">{{#each examples}}<li>“{{this}}”</li>{{/each}}</ul>
      {{/if}}
    </div>
  </div>
  {{/each}}
</section>
{{/if}}
