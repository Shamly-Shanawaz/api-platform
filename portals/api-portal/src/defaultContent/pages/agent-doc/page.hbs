{{!-- An agent's document or definition, in the API/MCP docs layout: breadcrumb, the docs nav
     (pages/docs/partials/docs-nav.hbs: SPECIFICATION, then one group per document type) and
     the content. Definitions use the API pages' viewers (pages/partials/api-specification.hbs):
     OpenAPI in Stoplight Elements, AsyncAPI in the AsyncAPI viewer; the Agent Card is JSON.
     Markdown arrives sanitized (docHtml); anything else is shown as escaped text. --}}
{{#if isCard}}
{{#pageHead}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
{{/pageHead}}
{{#pageScripts}}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" integrity="sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp" crossorigin="anonymous"></script>
  <script src='{{basePath}}/technical-scripts/agent-landing.js' defer></script>
{{/pageScripts}}
{{/if}}
{{#if isGuide}}
{{#pageScripts}}
  <script src='{{basePath}}/technical-scripts/agent-landing.js' defer></script>
{{/pageScripts}}
{{/if}}
<div class="page-container">
<nav class="dp-breadcrumb">
  <a class="dp-breadcrumb-item" href="{{baseUrl}}/agents">Agents</a>
  <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
  <a class="dp-breadcrumb-item" href="{{baseDocUrl}}">{{apiMetadata.name}}</a>
  <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
  <span class="dp-breadcrumb-current">Documentation</span>
</nav>
<div class="page-header">
  <h1 class="page-title">Documentation</h1>
</div>

<div class="adoc-wrap">
  {{> docs-nav}}

  <div class="adoc-content-card">
    {{#if isEmpty}}
    {{!-- The nav link always leads here, as for MCP; say so when there is nothing yet. --}}
    <div class="apilist-empty">
      <div class="apilist-empty-icon"><i class="bi bi-info-circle"></i></div>
      <div class="apilist-empty-body">
        <div class="apilist-empty-title">No documentation yet</div>
        <p class="apilist-empty-desc">This agent has no definition files or documents. Its page shows how to use it.</p>
      </div>
    </div>
    {{else if isSpec}}
    <div class="agent-spec-bar">
      <div class="adoc-file-badge {{#if isGuide}}adoc-file-badge--doc{{else}}adoc-file-badge--spec{{/if}}">
        <i class="bi {{#if isGuide}}bi-file-text{{else}}bi-code-slash{{/if}}"></i> {{spec.file}}
      </div>
      {{#if spec.downloadUrl}}
      <a class="dp-btn dp-btn--outline" href="{{spec.downloadUrl}}" download="{{spec.file}}">
        <i class="bi bi-download"></i> Download
      </a>
      {{/if}}
    </div>
    {{#if isCard}}
    <div class="mc-json-block agent-code">
      <button type="button" class="copy-btn agent-code-copy" data-copy-target="agent-spec-card" title="Copy" aria-label="Copy"><span class="copy-btn-icon"><i class="bi bi-copy"></i></span><span class="copy-btn-check"><i class="bi bi-check"></i> Copied</span></button>
      <pre><code id="agent-spec-card" class="language-json">{{cardText}}</code></pre>
    </div>
    {{else if isGuide}}
    <div class="api-markdown-content" data-agent-copy-blocks>{{{guideHtml}}}</div>
    {{else if isOpenApi}}
    {{> api-specification apiType=viewerType swagger=swagger}}
    {{else if isAsyncApi}}
    {{> api-specification apiType=viewerType asyncapi=asyncapi}}
    {{else}}
    <pre class="agent-doc-text"><code>{{rawText}}</code></pre>
    {{/if}}
    {{else}}
    <div class="adoc-file-badge adoc-file-badge--doc">
      <i class="bi bi-file-text"></i> {{docName}}
    </div>
    {{#if docHtml}}
    <div class="api-markdown-content agent-doc">{{{docHtml}}}</div>
    {{else}}
    <pre class="agent-doc-text"><code>{{docText}}</code></pre>
    {{/if}}
    {{/if}}
  </div>
</div>
</div>
